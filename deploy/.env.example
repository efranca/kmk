# Copy to deploy/.env (git-ignored) and fill in.
# Runtime role (INSERT-only on audit_log): create with psql, see docs/superpowers/plans/2026-11-17-kmk-phase2-core-auth.md
DATABASE_URL=postgresql+psycopg://kmk_app:change-me@127.0.0.1:5432/kmk
# Owner role, used only by Alembic migrations at container start
MIGRATION_DATABASE_URL=postgresql+psycopg://kmk:change-me@127.0.0.1:5432/kmk
# Random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me
API_HOST=127.0.0.1
API_PORT=8001
COOKIE_SECURE=true
# Email. "log" prints each message (links included) to `docker logs kmk-api`: development only.
# To send real mail: EMAIL_BACKEND=resend, set RESEND_API_KEY, then `docker compose up -d`.
EMAIL_BACKEND=log
# RESEND_API_KEY=
EMAIL_FROM=KMK Entretien <no-reply@mail.kmk-entretien.ca>
PUBLIC_BASE_URL=https://app.kmk-entretien.ca

# Two-step verification (TOTP).
# Fernet key that encrypts TOTP secrets: generate with
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK IT UP with the database backups: without it every stored TOTP secret is unreadable.
MFA_ENCRYPTION_KEY=change-me
# Roles forced to use TOTP (comma-separated). Empty = nobody is forced (two-step is only encouraged).
# MFA_REQUIRED_ROLES=admin,superadmin

# Web Push (notifications for admins). Generate once with: docker compose exec api python -m app.cli vapid-keys
# Empty = no push is sent. Keep the private key secret; changing the pair turns every device's notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kmk-entretien.ca

# Visit photos: the host folder mounted into the api container. Leave it unset to use the default /var/lib/kmk/visit-photos
# (prepare it before the first deploy: docs/operations.md, "Visit photos"). If you change it here, give the backup the
# same value (systemctl --user edit kmk-backup.service, then Environment=KMK_VISIT_PHOTOS_HOST_DIR=...), or it reads the default.
# KMK_VISIT_PHOTOS_HOST_DIR=/var/lib/kmk/visit-photos
