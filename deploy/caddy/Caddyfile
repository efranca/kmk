{
	admin off
	auto_https disable_redirects
	servers 127.0.0.1:8081 {
		trusted_proxies static 127.0.0.1/32 ::1/128
		client_ip_headers Cf-Connecting-Ip
	}
}

http://app.kmk-entretien.ca:8081 {
	bind 127.0.0.1
	encode zstd gzip
	log
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8001 {
			# Overwrites anything the client sent; resolved from Cf-Connecting-Ip for the trusted tunnel peer.
			header_up X-Real-Client-Ip {client_ip}
		}
	}

	# Missing assets must 404, not fall back to index.html
	handle /assets/* {
		root * /srv/site
		file_server
	}

	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
	}
}
