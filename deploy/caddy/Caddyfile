{
	admin off
	auto_https disable_redirects
	servers 127.0.0.1:8081 {
		trusted_proxies static 127.0.0.1/32 ::1/128
		client_ip_headers Cf-Connecting-Ip
	}
}

(api_proxy) {
	reverse_proxy 127.0.0.1:8001 {
		# Overwrites anything the client sent; resolved from Cf-Connecting-Ip for the trusted tunnel peer.
		header_up X-Real-Client-Ip {client_ip}
		# Approximate place from Cloudflare (informational, shown to the super admin). Always overwritten here, so a
		# browser cannot choose them; the city only exists when the "Add visitor location headers" transform is on.
		header_up X-Geo-Country {http.request.header.Cf-Ipcountry}
		header_up X-Geo-City {http.request.header.Cf-Ipcity}
	}
}

http://app.kmk-entretien.ca:8081 {
	bind 127.0.0.1
	encode zstd gzip
	log
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# A document file goes up as the raw body of this one request. Everything else under /api is tiny JSON.
	@docfile {
		method PUT
		path_regexp ^/api/documents/[0-9]+/file$
	}
	handle @docfile {
		request_body {
			max_size 51MiB
		}
		import api_proxy
	}

	handle /api/* {
		# Every other API request body is tiny JSON: refuse anything bigger before it reaches the application.
		request_body {
			max_size 64KB
		}
		import api_proxy
	}

	# Missing assets must 404, not fall back to index.html
	handle /assets/* {
		root * /srv/site
		file_server
	}

	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
	}
}
