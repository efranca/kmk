{
	admin off
	auto_https disable_redirects
	servers 127.0.0.1:8081 {
		trusted_proxies static 127.0.0.1/32 ::1/128
		client_ip_headers Cf-Connecting-Ip
	}
}

(api_proxy) {
	reverse_proxy 127.0.0.1:8001 {
		# Overwrites anything the client sent; resolved from Cf-Connecting-Ip for the trusted tunnel peer.
		header_up X-Real-Client-Ip {client_ip}
		# Approximate place from Cloudflare (informational, shown to the super admin). Always overwritten here, so a
		# browser cannot choose them; the city only exists when the "Add visitor location headers" transform is on.
		header_up X-Geo-Country {http.request.header.Cf-Ipcountry}
		header_up X-Geo-City {http.request.header.Cf-Ipcity}
	}
}

http://app.kmk-entretien.ca:8081 {
	bind 127.0.0.1
	encode zstd gzip
	log
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'; worker-src 'self'"
		-Server
	}

	# A document file goes up as the raw body of this one request. Everything else under /api is tiny JSON.
	@docfile {
		method PUT
		path_regexp ^/api/documents/[0-9]+/file$
	}
	handle @docfile {
		request_body {
			max_size 51MiB
		}
		import api_proxy
	}

	# The small preview picture of a document (the API accepts at most 100 KB).
	@docpreview {
		method PUT
		path_regexp ^/api/documents/[0-9]+/preview$
	}
	handle @docpreview {
		request_body {
			max_size 128KB
		}
		import api_proxy
	}

	# The quote form's first call carries up to 20 000 characters of text (accents and emoji take several bytes each).
	@quotestart {
		method POST
		path /api/public/quotes
	}
	handle @quotestart {
		request_body {
			max_size 256KB
		}
		import api_proxy
	}

	# One photo of a quote request goes up as the raw body (the API accepts at most 8 MiB).
	@quotephoto {
		method PUT
		path_regexp ^/api/public/quotes/[0-9]+/photos$
	}
	handle @quotephoto {
		request_body {
			max_size 9MiB
		}
		import api_proxy
	}

	handle /api/* {
		# Every other API request body is tiny JSON: refuse anything bigger before it reaches the application.
		request_body {
			max_size 64KB
		}
		import api_proxy
	}

	# The public quote form is its own page (frontend/quote.html), not the signed-in app.
	@devis path /devis /devis/
	handle @devis {
		rewrite * /quote.html
		root * /srv/site
		file_server
	}

	# Missing assets must 404, not fall back to index.html
	handle /assets/* {
		root * /srv/site
		file_server
	}

	handle {
		root * /srv/site
		try_files {path} /index.html
		file_server
	}
}
